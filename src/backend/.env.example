# Copy this file to .env. The defaults match docker-compose.yml, so with
# `docker compose up -d` no change is needed. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection — docker-compose.yml publishes the database on host
# port 5433 so it does not clash with a PostgreSQL installed on the machine.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=pharmacy_app
DB_PASSWORD=pharmacy_dev_password
DB_NAME=pharmacy_stock

# Lets TypeORM create the tables from the entities. Local development only,
# and only until migrations replace it in week 4. Never enable it against a
# shared database: it rewrites the schema on every boot.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
