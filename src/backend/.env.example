# Copy this file to .env. The defaults match docker-compose.yml, so with
# `docker compose up -d` no change is needed. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection — docker-compose.yml publishes the database on host
# port 5433 so it does not clash with a PostgreSQL installed on the machine.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=pharmacy_app
DB_PASSWORD=pharmacy_dev_password
DB_NAME=pharmacy_stock

DB_LOGGING=false

# The schema is built by migrations only: npm run migration:run
# The e2e tests create and reset this separate database; never point it at
# the development database.
DB_TEST_NAME=pharmacy_stock_test

# Sign-in (UC16). "jwt": sign in with a password on the sign-in page; this is
# the default when AUTH_MODE is not set. "dev": the old X-Dev-User switch with
# no password, used only by the e2e tests now. Never use "dev" outside your
# own machine; the backend refuses it in production.
AUTH_MODE=jwt

# Signs session tokens. Any long random string; this one is for local use
# only. Required when AUTH_MODE=jwt.
JWT_SECRET=local-dev-only-change-me-3f9a1c7e5b2d4f6a8c0e

# Password the seed gives the sample accounts manager, pharmacist and cashier
# (README, "Sample accounts"). Local use only. Leave empty for no password.
SEED_PASSWORD=Pharmacy@2026

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
